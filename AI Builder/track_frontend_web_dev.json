  "topic_card_template": {
    "mode": "evidence_first",
    "retrieval_policy": {
      "min_sources": 3,
      "prefer": [
        "official_docs",
        "standards",
        "peer_reviewed",
        "reputable_org_blogs"
      ],
      "avoid": [
        "paywalled_fulltext",
        "scraped_long_passages"
      ],
      "cache_ttl_hours": 72
    },
    "sections": [
      "What it is (2\u20134 sentences, cited)",
      "Why it matters (1\u20132 bullets, cited where factual)",
      "Key ideas (5\u20138 bullets, cited)",
      "Common misconceptions (3 bullets, cited)",
      "Worked example (original, can cite concepts)",
      "Practice (3 questions + answers)",
      "Proof task (measurable output)",
      "Next nodes (and why, based on prereqs)"
    ],
    "prompt_skeleton": "Generate a Topic Card for {topic.name}. Use ONLY provided evidence snippets for factual claims; cite like [1], [2]. Keep it practical."
  }
