  "diagnostic": {
    "estimated_minutes": 10,
    "core_confidence_sliders": [
      {
        "topic_id": "DataCleaning",
        "prompt": "How confident are you cleaning and validating messy data?",
        "scale": "0-5"
      },
      {
        "topic_id": "SQL",
        "prompt": "How confident are you writing basic SQL queries?",
        "scale": "0-5"
      },
      {
        "topic_id": "VizBasics",
        "prompt": "How confident are you choosing and designing charts?",
        "scale": "0-5"
      },
      {
        "topic_id": "KPIs",
        "prompt": "How confident are you defining good KPIs for a business question?",
        "scale": "0-5"
      }
    ],
    "core_micro_quiz": [
      {
        "id": "da_core_1",
        "topic_id": "SQLAgg",
        "prompt": "A GROUP BY query produces\u2026",
        "options": [
          "a single raw table",
          "aggregated rows per group",
          "a chart",
          "a database backup"
        ],
        "correct_index": 1
      },
      {
        "id": "da_core_2",
        "topic_id": "Correlation",
        "prompt": "Correlation implies causation.",
        "options": [
          "True",
          "False"
        ],
        "correct_index": 1
      }
    ],
    "outcome_micro_quiz_pool": [
      {
        "id": "da_excel_1",
        "outcome_id": "excel_dashboard",
        "topic_id": "DashboardDesign",
        "prompt": "A good dashboard first answers\u2026",
        "options": [
          "every question",
          "the stakeholder\u2019s key decisions",
          "only technical metrics",
          "only daily updates"
        ],
        "correct_index": 1
      },
      {
        "id": "da_sql_1",
        "outcome_id": "sql_bi_reporting",
        "topic_id": "SQLJoins",
        "prompt": "A LEFT JOIN keeps\u2026",
        "options": [
          "only matches in both tables",
          "all rows from the left + matches from right",
          "all rows from right only",
          "no rows"
        ],
        "correct_index": 1
      },
      {
        "id": "da_py_1",
        "outcome_id": "python_stats",
        "topic_id": "Pandas",
        "prompt": "A DataFrame is best described as\u2026",
        "options": [
          "a database server",
          "a 2D labeled table structure",
          "a chart type",
          "a JSON API"
        ],
        "correct_index": 1
      },
      {
        "id": "da_py_2",
        "outcome_id": "python_stats",
        "topic_id": "Hypothesis",
        "prompt": "A 95% confidence interval means\u2026",
        "options": [
          "95% chance the null is true",
          "a range of plausible values under the model",
          "the sample is unbiased",
          "the effect is proven"
        ],
        "correct_index": 1
      }
    ]
  },
  "topic_card_template": {
    "mode": "evidence_first",
    "retrieval_policy": {
      "min_sources": 3,
      "prefer": [
        "official_docs",
        "standards",
        "peer_reviewed",
        "reputable_org_blogs"
      ],
      "avoid": [
        "paywalled_fulltext",
        "scraped_long_passages"
      ],
      "cache_ttl_hours": 72
    },
    "sections": [
      "What it is (2\u20134 sentences, cited)",
      "Why it matters (1\u20132 bullets, cited where factual)",
      "Key ideas (5\u20138 bullets, cited)",
      "Common misconceptions (3 bullets, cited)",
      "Worked example (original, can cite concepts)",
      "Practice (3 questions + answers)",
      "Proof task (measurable output)",
      "Next nodes (and why, based on prereqs)"
    ],
    "prompt_skeleton": "Generate a Topic Card for {topic.name}. Use ONLY provided evidence snippets for factual claims; cite like [1], [2]. Keep it practical."
  }
}